#include <stdio.h>
#include <string.h>

/*
    Programa: Sistema de Cadastro de Territórios
    Objetivo: Cadastrar até 5 territórios e exibir suas informações.
    Funcionalidades:
        1. Cadastrar território
        2. Listar territórios cadastrados
        3. Sair do programa
    Autor: [Seu Nome]
    Data: [Data Atual]
*/

/* 
    Estrutura que representa um território.
    Campos:
        - nome: nome do território
        - cor: cor do exército
        - tropas: quantidade de tropas
*/
struct Territorio {
    char nome[30];
    char cor[15];
    int tropas;
};

// Função para remover o '\n' do final de uma string lida com fgets
void limparQuebraLinha(char *str) {
    str[strcspn(str, "\n")] = '\0';
}

int main() {
    struct Territorio territorios[5]; // Vetor que armazena até 5 territórios
    int quantidade = 0;               // Contador de territórios cadastrados
    int opcao;                        // Opção do menu

    do {
        printf("\n=== MENU DE TERRITÓRIOS ===\n");
        printf("1. Cadastrar novo território\n");
        printf("2. Listar territórios cadastrados\n");
        printf("3. Sair\n");
        printf("Escolha uma opção: ");
        scanf("%d", &opcao);
        getchar(); // Limpa o buffer após leitura de número

        switch (opcao) {
            case 1:
                if (quantidade < 5) {
                    printf("\n--- Cadastro de Território %d ---\n", quantidade + 1);

                    printf("Digite o nome do território: ");
                    fgets(territorios[quantidade].nome, 30, stdin);
                    limparQuebraLinha(territorios[quantidade].nome);

                    printf("Digite a cor do exército: ");
                    fgets(territorios[quantidade].cor, 15, stdin);
                    limparQuebraLinha(territorios[quantidade].cor);

                    printf("Digite a quantidade de tropas: ");
                    scanf("%d", &territorios[quantidade].tropas);
                    getchar(); // limpa o buffer

                    quantidade++;
                    printf("\n✅ Território cadastrado com sucesso!\n");
                } else {
                    printf("\n⚠️ Limite de 5 territórios atingido!\n");
                }
                break;

            case 2:
                if (quantidade == 0) {
                    printf("\n⚠️ Nenhum território cadastrado ainda.\n");
                } else {
                    printf("\n=== LISTA DE TERRITÓRIOS ===\n");
                    for (int i = 0; i < quantidade; i++) {
                        printf("\nTerritório %d:\n", i + 1);
                        printf("Nome: %s\n", territorios[i].nome);
                        printf("Cor do Exército: %s\n", territorios[i].cor);
                        printf("Tropas: %d\n", territorios[i].tropas);
                        printf("-----------------------------\n");
                    }
                }
                break;

            case 3:
                printf("\nEncerrando o programa... 👋\n");
                break;

            default:
                printf("\n❌ Opção inválida! Tente novamente.\n");
        }

    } while (opcao != 3);

    return 0;
}
